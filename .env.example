# ============================================================================
# EL NOUR DASHBOARD - Environment Variables
# Copy this file to .env.local and fill in your actual values.
# NEVER commit real secrets — placeholders only in this file.
# ============================================================================

# ============================================================================
# SUPABASE CONFIGURATION (Required)
# Get these from: https://supabase.com/dashboard/project/<your-project>/settings/api
# ============================================================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ============================================================================
# EASYORDERS INTEGRATION (Optional - for order sync; key can also be managed
# from the app UI at /settings/integrations and is stored encrypted)
# ============================================================================
EASYORDERS_API_KEY=your-easyorders-api-key
EASYORDERS_STORE_ID=your-easyorders-store-id

# ============================================================================
# APPLICATION SETTINGS
# ============================================================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# ============================================================================
# OPTIONAL: ANALYTICS & MONITORING
# ============================================================================
# NEXT_PUBLIC_GA_ID=
# SENTRY_DSN=

# ============================================================================
# EMAIL CONFIGURATION (Optional - for notifications)
# ============================================================================
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password
# EMAIL_FROM=noreply@elnour-dashboard.com

# ============================================================================
# STORAGE (Optional - for file uploads)
# ============================================================================
# AWS_S3_BUCKET=your-bucket
# AWS_S3_REGION=us-east-1
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key

# ============================================================================
# CREDENTIAL ENCRYPTION (Required for secure API key storage)
# Generate: openssl rand -hex 32
# ============================================================================
CREDENTIALS_ENCRYPTION_KEY=generate-with-openssl-rand-hex-32


# ── Registration ──────────────────────────────────────────────────────────────
# Self-registration is ALLOW-LIST ONLY. Comma-separated list of the addresses
# that may create an account. UNSET means registration is CLOSED (HTTP 403).
# A new account starts as `viewer` and inactive; the server promotes it.
# REGISTRATION_ALLOWED_EMAILS=owner@example.com,staff@example.com

# ── Cron + internal workers ───────────────────────────────────────────────────
# A random string. Clients send it as `Authorization: Bearer ${CRON_SECRET}`.
# Without it the cron routes answer 503 — they never fall open.
# CRON_SECRET=change_me_to_a_long_random_string

# Optional explicit secret for the server-to-server queue trigger. When unset,
# the app derives it from CREDENTIALS_ENCRYPTION_KEY.
# INTERNAL_TRIGGER_SECRET=

# The origin this server calls ITSELF on for the queue / backfill chain.
# Never derived from the inbound request's Host header.
# INTERNAL_ORIGIN=https://your-app.vercel.app


# ── Read-only external API (/api/v1/*) and the MCP server (/api/mcp) ────────
# A random string. Clients send it as `x-api-key` (or `Authorization: Bearer`).
# Without it these endpoints answer 503 — they never fall open.
REPORTS_API_KEY=change_me_to_a_long_random_string
